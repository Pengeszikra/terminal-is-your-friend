{
  "_comment": "Compiler configuration by OpenAI Codex. Compiled with the pipeline fork.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": ".compiled",
    "types": []
  },
  "include": ["src/**/*.ts"]
}
